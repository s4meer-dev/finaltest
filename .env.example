# Execution & Paper Trading Mode (alpaca | paper)
TRADE_MODE=alpaca
ORDER_CONFIRMATION=manual

# Alpaca Paper Trading API (https://app.alpaca.markets/dashboard/overview)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_URL=https://data.alpaca.markets/v2
ALPACA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex

# TradingView Deep Linking
TRADINGVIEW_BASE_URL=https://in.tradingview.com/chart

# Monitored Symbols (US Equities & ETFs or Crypto)
SYMBOLS=AAPL,TSLA,NVDA,SPY,QQQ

# Trading Parameters
INITIAL_CAPITAL=100000
RISK_PER_TRADE=0.01
MAX_TRADES_PER_DAY=5
MAX_DAILY_LOSS=-5000
MAX_CONCURRENT_POSITIONS=3
SCORE_THRESHOLD=0.6

# Model & Storage
MODEL_DIR=models/saved
MACRO_MODEL_PATH=models/saved/macro_model.pkl
MICRO_MODEL_PATH=models/saved/micro_model.pkl

# Database (optional if using live stream/in-memory)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USER=postgres
DB_PASSWORD=postgres

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
